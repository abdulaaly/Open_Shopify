{
  "name": "vendr-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VENDR — Open-Source Enterprise Commerce Engine (Shopify-Killer Architecture)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @vendr/database generate",
    "db:push": "pnpm --filter @vendr/database push",
    "db:seed": "pnpm --filter @vendr/database seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@12.21.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@turbo/windows-64"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
