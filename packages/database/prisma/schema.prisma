datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  domain       String?       @unique
  currencyCode String        @default("USD")
  timezone     String        @default("UTC")
  plan         String        @default("ENTERPRISE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  products     Product[]
  collections  Collection[]
  locations    Location[]
  orders       Order[]
  customers    Customer[]
  discounts    Discount[]
  webhooks     Webhook[]
  metafields   Metafield[]
  metaobjects  Metaobject[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  role         String   @default("MERCHANT_ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Product {
  id               String           @id @default(uuid())
  tenantId         String
  title            String
  handle           String
  description      String?
  status           String           @default("ACTIVE")
  vendor           String?
  productType      String?
  tags             String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]

  @@unique([tenantId, handle])
  @@index([tenantId])
  @@map("products")
}

model ProductVariant {
  id                 String           @id @default(uuid())
  productId          String
  title              String
  sku                String?
  barcode            String?
  price              Decimal          @db.Decimal(12, 2)
  compareAtPrice     Decimal?         @db.Decimal(12, 2)
  costPerItem        Decimal?         @db.Decimal(12, 2)
  inventoryQuantity  Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id                String       @id @default(uuid())
  tenantId          String
  orderNumber       Int
  email             String?
  financialStatus   String       @default("PENDING")
  fulfillmentStatus String       @default("UNFULFILLED")
  currencyCode      String       @default("USD")
  totalPrice        Decimal      @db.Decimal(12, 2)
  subtotalPrice     Decimal      @db.Decimal(12, 2)
  totalTax          Decimal      @default(0) @db.Decimal(12, 2)
  totalDiscounts    Decimal      @default(0) @db.Decimal(12, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("orders")
}
